return {
  summary = "Steal Pokemon from other trainers with the SNAG BALL, and fence what you steal for more balls.",
  author  = "Mister Miracle",

  tags = { "story", "quest", "mechanic" },

  differences = {
    changed = {
      "the girl in Viridian City (TEXT_VIRIDIANCITY_GIRL) offers a new quest once you have the Pokedex; her original pre-Pokedex line is untouched",
      "once earned, a SNAG BALL can be thrown at a trainer's Pokemon and roll a real catch attempt, same as a wild encounter -- by default, the trainer then sends out their next Pokemon and the fight continues, exactly like a normal faint would",
    },
    added = {
      "new item + ball: SNAG BALL (10,000 to buy once unlocked), thrown with the Ultra/Master-tier toss arc and flicker",
      "new trainer class: a PICNICKER (OPP_SNAG_QUEST_PICNICKER, real sprite/data class OPP_JR_TRAINER_F) holding a single Meowth",
      "a short questline via Quest System: one Snag Ball in, a guaranteed catch on the quest Meowth only, one Snag Ball back as the reward, with a real turn-in step (party picker, any Meowth qualifies)",
      "optional shiny integration: the quest's Meowth is genuinely shiny by data always, and visually shiny too if the Shiny Pokemon mod is installed",
      "a GET NEW SNAG BALLS option (BOTH / MART / FENCES, default BOTH) choosing where post-quest Snag Balls come from -- marts stock them at 10,000 at the same shops Custom Pokeballs uses for GREAT/ULTRA BALL",
      "a [DEV] option to replay the Meowth quest for testing (default off)",
      "a snagged Pokemon gets persistent markers (mon.snagged, mon.snagFrom, mon.snagLevel; survive save/load) for other mods and this mod's own fence to key off",
      "after the quest, two NPCs become fences: the Celadon Game Corner gambler (Red/Blue and Yellow both covered) and the Pewter City man who explains badge-based obedience (needs the BOULDERBADGE). Hand either a snagged Pokemon for 1-5 SNAG BALLs, priced by snag level, species rarity, and VIP provenance (rival/gym leaders/Elite Four/Giovanni)",
    },
    known = {
      "with \"Continue battle after snag\" on (default), a snag also awards EXP and plays the faint sound/slide, since it routes through the real faint pipeline -- a normal catch never does either",
      "with that option off, a snag ends the trainer battle immediately even if they had other Pokemon left",
    },
  },

  credits = {
    { who = "Quest System", for_ = "the journal, NPC markers and quest state this mod registers into" },
    { who = "Custom Pokeballs", for_ = "the item+ball registry pattern this mod's Snag Ball follows, and the mart list its shop unlock reuses" },
    { who = "Team Rocket Returns", for_ = "the map_scripts/Flags/base_talk dialogue pattern and custom trainer-class registration this mod follows" },
    { who = "Shiny Pokemon", for_ = "the optional shiny-DV generator this mod's Meowth uses when that mod is installed" },
  },

  compat = { engine = ">=0.1.38 <2.0.0", modApi = 2 },
}
